node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnp
.pnp.js

# ============================================
# ENVIRONMENT FILES (SECRETS - NEVER COMMIT)
# ============================================
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env.staging

# Backend env
backend/.env
backend/.env.*
!backend/.env.example

# Frontend env
frontend/.env
frontend/.env.*
!frontend/.env.example

# ============================================
# BUILD OUTPUTS
# ============================================
dist/
build/
frontend/dist/
frontend/build/

# ============================================
# LOGS
# ============================================
logs/
*.log
backend/logs/

# ============================================
